{
	"version": 6,
	"configurePresets": [
		{
			"name": "compile-release",
			"binaryDir": "${sourceDir}/build/release",
			"generator": "Ninja",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release"
			}
		},
    {
			"name": "compile-debug",
			"binaryDir": "${sourceDir}/build/debug",
			"generator": "Ninja",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug"
			}
		}
	]
}
